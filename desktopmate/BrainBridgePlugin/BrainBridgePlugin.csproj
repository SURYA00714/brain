<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BrainBridgePlugin</AssemblyName>
    <Description>Brain Desktop Mate BepInEx Bridge Plugin</Description>
    <Version>2.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <DesktopMateDir>/home/jai/Downloads/Brain/desktopmate/Desktop Mate</DesktopMateDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 Core References -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(DesktopMateDir)/BepInEx/core/BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(DesktopMateDir)/BepInEx/core/BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(DesktopMateDir)/BepInEx/core/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity Interop References -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DesktopMateDir)/BepInEx/interop/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(DesktopMateDir)/BepInEx/interop/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(DesktopMateDir)/BepInEx/interop/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(DesktopMateDir)/BepInEx/interop/Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DesktopMateDir)/BepInEx/interop/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VRM10">
      <HintPath>$(DesktopMateDir)/BepInEx/interop/VRM10.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.UniWindowController">
      <HintPath>$(DesktopMateDir)/BepInEx/interop/Unity.UniWindowController.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\Desktop Mate\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>



</Project>
